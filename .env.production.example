# ═════════════════════════════════════════════════════════════
# WALHI Jawa Barat — Production Environment Configuration
# Salin file ini menjadi .env pada server live / VPS produksi:
# cp .env.production.example .env
# ═════════════════════════════════════════════════════════════

# ── IDENTITAS APLIKASI ──
APP_NAME="WALHI Jawa Barat"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://walhijabar.co.id
APP_KEY=

# Catatan APP_URL:
# Jika pada tahap awal deployment website diakses via IP VPS sebelum domain / SSL aktif:
# Ganti sementara dengan: APP_URL=http://<IP-SERVER-VPS>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Keamanan Password Hashing (Bcrypt Rounds)
BCRYPT_ROUNDS=12

# ── LOGGING SYSTEM ──
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=30
LOG_MAX_FILES=30

# ── BASIS DATA (MySQL Container Production) ──
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=walhi_prod
DB_USERNAME=walhi_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT
DB_ROOT_PASSWORD=GANTI_DENGAN_ROOT_PASSWORD_KUAT

# ── SESSION & KEAMANAN COOKIE ──
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Keamanan Cookie:
# Set 'true' untuk domain HTTPS (https://walhijabar.co.id).
# Hanya set 'false' jika menguji sementara via protokol HTTP biasa tanpa SSL.
SESSION_SECURE_COOKIE=true

# ── MEDIA STORAGE, CACHE & QUEUE ──
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=walhi_cache_

# ── EMAIL (SMTP Pengiriman Notifikasi & Reset Password) ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=kontak@walhijabar.co.id
MAIL_PASSWORD=GANTI_DENGAN_APP_PASSWORD_EMAIL
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="kontak@walhijabar.co.id"
MAIL_FROM_NAME="WALHI Jawa Barat"

# Catatan Email SMTP:
# 1. Jika menggunakan Google Workspace / Gmail, isi MAIL_PASSWORD dengan App Password 16 digit.
# 2. Jika belum memiliki kredensial email aktif, ubah MAIL_MAILER=log agar pengujian tidak error.

# ── MIDTRANS PAYMENT GATEWAY (PRODUKSI) ──
MIDTRANS_SERVER_KEY=Mid-server-GANTI_DENGAN_SERVER_KEY_PRODUKSI
MIDTRANS_CLIENT_KEY=Mid-client-GANTI_DENGAN_CLIENT_KEY_PRODUKSI
MIDTRANS_IS_PRODUCTION=true
# Konfirmasi status webhook ke Status API Midtrans (disarankan tetap true)
MIDTRANS_VERIFY_WEBHOOK_STATUS=true
# Allowlist IP webhook opsional (default nonaktif; signature selalu diverifikasi).
# Aktifkan hanya dengan daftar IP yang dikonfirmasi Midtrans, dipisah koma.
MIDTRANS_WEBHOOK_IP_WHITELIST=false
# MIDTRANS_WEBHOOK_IPS=103.208.23.0/24,103.127.16.0/24,103.127.17.0/24
MIDTRANS_TIMEOUT=10
MIDTRANS_CONNECT_TIMEOUT=5
# Donasi pending dicek ulang setelah N menit dan dikedaluwarsakan setelah N jam
MIDTRANS_RECONCILE_AFTER_MINUTES=15
MIDTRANS_EXPIRE_AFTER_HOURS=24

# Catatan Midtrans:
# 1. Masukkan Server Key & Client Key resmi dari Dashboard Midtrans (Production Mode).
# 2. Jika masih ingin simulasi transaksi di Sandbox, ubah:
#    MIDTRANS_IS_PRODUCTION=false
#    dan gunakan Client/Server key sandbox (awalan SB-Mid-...).

# ── KREDENSIAL SEED ADMIN & EDITOR ──
# Digunakan saat database di-seed pertama kali:
ADMIN_EMAIL=admin@walhijabar.co.id
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT
EDITOR_EMAIL=editor@walhijabar.co.id
EDITOR_PASSWORD=GANTI_DENGAN_PASSWORD_EDITOR_KUAT
FORCE_ADMIN_PASSWORD_RESET=false
# Wajibkan 2FA (TOTP) untuk akun admin & editor
AUTH_2FA_ENFORCED=true

# ── KEAMANAN URL LOGIN ADMIN ──
# Ganti /login default menjadi path rahasia (contoh: portal-jabar -> walhijabar.co.id/portal-jabar)
ADMIN_LOGIN_PATH=portal-jabar


# ── KONTROL STARTUP CONTAINER DOCKER ──
SEED_ON_START=false
MIGRATE_ON_START=false
CLEAR_CACHE_ON_START=false

# ── PORT WEB SERVER (NGINX REVERSE PROXY) ──
HTTP_PORT=80
HTTPS_PORT=443
